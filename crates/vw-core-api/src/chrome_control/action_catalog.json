{
  "description": "App action descriptions and schemas; generated by tools/public/codegen/chrome_actions.py. Applied only to arguments advertised by the running helper.",
  "actions": [
    {
      "id": "clipboard.read",
      "capability": "clipboard.read",
      "description": "Read plain clipboard text on an explicit chat action in this chat’s own tab. Full access; at most 65536 UTF-8 bytes, with truncated:true when capped. Stop cancels pending access.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": []
      }
    },
    {
      "id": "clipboard.write",
      "capability": "clipboard.write",
      "description": "Write plain clipboard text for this chat’s own tab. Full access; at most 65536 UTF-8 bytes. Empty text clears it. Stop cancels pending access.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "text": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "id": "network.intercept",
      "capability": "network.intercept",
      "description": "Replace this chat-owned tab’s request rules (first matching URL glob wins; * matches any text). Full access. Block, redirect to url, or fulfill with status, optional headers and a UTF-8 body (65536 bytes per rule, 262144 total). Network and form guards run first. Send rules:[] to clear; Stop/close clears rules.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "rules": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pattern": {
                  "type": "string",
                  "maxLength": 2048
                },
                "action": {
                  "enum": [
                    "block",
                    "redirect",
                    "fulfill"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 8192
                },
                "status": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 599
                },
                "headers": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ]
                  }
                },
                "body": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "pattern",
                "action"
              ]
            }
          }
        },
        "required": [
          "rules"
        ]
      }
    },
    {
      "id": "tabs.emulate",
      "capability": "tabs.emulate",
      "description": "Replace device metrics, color scheme, user agent and touch for a tab in this chat’s own window. Accept edits or Full access. Supply width/height/deviceScaleFactor together; unspecified overrides reset. reset:true clears all. Status reports overrides; Stop/close resets them.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "deviceScaleFactor": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 8
          },
          "colorScheme": {
            "enum": [
              "dark",
              "light"
            ]
          },
          "userAgent": {
            "type": "string",
            "maxLength": 1024
          },
          "touch": {
            "type": "boolean"
          },
          "reset": {
            "type": "boolean"
          }
        },
        "required": []
      }
    },
    {
      "id": "files.wait_download",
      "capability": "files.download",
      "description": "Wait up to timeoutMs (default 20000) for a downloadId returned by this chat’s files.download or initiating page click. Omit downloadId only when exactly one download is attributed to this owned tab in the current lease. Unattributed or ambiguous downloads refuse with DOWNLOAD_AMBIGUOUS. Returns name, state and finished; timedOut:true means unfinished. Stop cancels the wait.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tabId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647

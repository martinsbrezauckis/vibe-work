{
  "name": "vibe-work-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "node ../scripts/public/link_ui_test_modules.mjs && tsc --noEmit && tsc --noEmit -p ../tests/public/ui/tsconfig.json",
    "lint": "node ../scripts/public/link_ui_test_modules.mjs && eslint . --max-warnings 0 --ignore-pattern style-drift.mjs --ignore-pattern vocabulary-drift.mjs && (cd ../tests/public/ui && node ../../../ui/node_modules/eslint/bin/eslint.js . --max-warnings 0) && node style-drift.mjs && node vocabulary-drift.mjs",
    "format:check": "node ../scripts/public/link_ui_test_modules.mjs && prettier --check . ../tests/public/ui",
    "test": "node ../scripts/public/link_ui_test_modules.mjs && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@tauri-apps/api": "2.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.4.0",
    "shiki": "4.5.0",
    "virtua": "0.53.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
